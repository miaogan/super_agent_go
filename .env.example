# Aegis 环境变量模板（★ 可入库、无任何密钥）
#
# 用法：cp .env.example .env 后填入真实值。
#
# ★ 为什么需要这个文件：
#   1. .env 被 .gitignore / .dockerignore 排除，所以它无法充当模板；
#   2. .env 里要填 6 个模型的真实 API Key，一旦入库就是密钥泄露；
#   3. 没有模板时，每个人只能靠翻 conf.go 才知道有哪些变量可设——
#      而 conf.go 里applyEnv 是显式声明的，不翻代码就不知道全貌。
#
# ★★ 命名规则（照抄错名字不会报错，只会被静默忽略）：
#   全部为 AEGIS_<段>__<字段>，段名与字段名见 configs/config.example.yaml。
#   可用以下命令自查一份文件里的变量名是否真的会被读取：
#     python3 scripts/env_audit.py
#
# ★★★ 模型 API Key 用「索引」注入，这是最容易出错的地方：
#   AEGIS_LLM__MODELS__<序号>__API_KEY
#   序号 = 该模型在 configs/*.yaml 里 llm.models 列表中的位置（0 起，不连续）。
#   改动 yaml 里的模型顺序会让序号指向另一个模型 —— 症状是
#   「Key 明明配了却401」，而日志里看不出任何配置错误。
#   核对方式：数 yaml 里第 N 个 `- name:` 就是序号 N。

# ---------- 模型服务 ----------
AEGIS_LLM__PROVIDER=rawhttp
AEGIS_LLM__DEFAULT_MODEL=qwen3.8-max
AEGIS_LLM__DEFAULT_EMBED_MODEL=qwen3.7-text-embedding-flash
AEGIS_LLM__DEFAULT_EMBED_DIM=1024

# 各模型的 API Key —— 按 yaml 中 models 的顺序填，序号 0 起
AEGIS_LLM__MODELS__0__API_KEY=
AEGIS_LLM__MODELS__1__API_KEY=
AEGIS_LLM__MODELS__2__API_KEY=
AEGIS_LLM__MODELS__3__API_KEY=
AEGIS_LLM__MODELS__4__API_KEY=
AEGIS_LLM__MODELS__5__API_KEY=

# ---------- 重排（rerank）----------
# 默认已开启（rerank_enabled: true）。这里显式写出是为了「配置可见」：
# 排查检索排序问题时，第一件事就是确认这几个值。
AEGIS_RAG__RERANK_ENABLED=true
# 留空则自动选模型名含 "rerank" 的第一个启用模型
AEGIS_RAG__RERANK_MODEL=
# 送入重排的候选数，必须 > AEGIS_RAG__DEFAULT_TOP_K，否则重排无意义
AEGIS_RAG__RERANK_TOP_K=20
# rerank 分数阈值（量纲与向量相似度不同，不能共用一个值）
AEGIS_RAG__RERANK_SCORE_THRESHOLD=0.3

# ---------- 向量库 ----------
AEGIS_MILVUS__ADDR=localhost:19530
# ★ Milvus 3.0 默认 authorizationEnabled=false（即任何人都能读写全部集合）；
#   服务端开启鉴权后，这两项必须配，否则连接被拒。
#
#★ 这两个空值对「用本仓库 compose 起本地环境」是不够的：
#   docker-compose.yml 里已经设了
#     COMMON_SECURITY_AUTHORIZATIONENABLED: "true"
#   所以本地开发必须填 Milvus 默认口令root / Milvus，
#   否则连本地 Milvus 也会被拒 —— 且报错是
#     Unauthenticated: missing authorization in header
#   它长得像「连不上」，很容易误判成 Milvus 没启动。
#
#   ⚠️ root/Milvus 仅限本地开发。任何非本机环境（共享开发机、
#     测试环境、预发）必须先改口令，否则等于把向量库敞开着。
AEGIS_MILVUS__USERNAME=root
AEGIS_MILVUS__PASSWORD=Milvus
AEGIS_MILVUS__COLLECTION=doc_chunks
AEGIS_MILVUS__DIM=1024

# ---------- 中间件地址（容器内服务名，非 localhost）----------
NACOS_ADDR=nacos
NACOS_PORT=8848
NACOS_NAMESPACE=aegis-dev
NACOS_USER=nacos
NACOS_PASSWORD=nacos

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=aegis
POSTGRES_USER=aegis
POSTGRES_PASSWORD=

GATEWAY_PORT=8000
# ---- nginx 统一入口（对外只暴露这两个端口）----
# gateway 已收敛到 127.0.0.1，宿主机访问一律经 nginx
GATEWAY_HTTP_PORT=80
GATEWAY_HTTPS_PORT=443

# ---------- 凭证（★ compose 引用，部署前必须覆盖默认值）----------
# 服务间内部认证令牌（Kitex TTHeader，pkg/internalauth）
# 留空 = 关闭认证（仅本地 mock 可接受）；生产必须 32+ 位强随机值
AEGIS_INTERNAL_TOKEN=aegis-internal-dev-token-change-me
# JWT 签名密钥（HS256 本地开发路径）
AEGIS_JWT_SECRET=aegis-dev-secret-change-me-in-production
# Milvus 账号（compose 已开 authorizationEnabled）
# ⚠️ root/Milvus 是 Milvus 出厂默认，仅限本机开发
AEGIS_MILVUS_USERNAME=root
AEGIS_MILVUS_PASSWORD=Milvus
# MinIO root 凭证（rag_service 与 Milvus 内部存储共用）
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ---------- JSON 引擎 ----------
# auto=用编译进来的那个；strict=true 时引擎不符即拒绝启动
AEGIS_JSON__ENGINE=auto
AEGIS_JSON__STRICT=false

# ---------- 可观测性 ----------
# 指标：默认开启，各服务健康端口暴露 /metrics（Prometheus 抓取）
# AEGIS_METRICS__ENABLED=true
# AEGIS_METRICS__PATH=/metrics
# 追踪：默认关闭（零开销）。开启步骤：
#   1. docker compose --profile obs up -d   （拉起 jaeger + prometheus）
#   2. 下面改为 true，重启业务服务
#   3. UI: Jaeger http://127.0.0.1:16686 / Prometheus http://127.0.0.1:9090
AEGIS_OTEL_ENABLED=false
AEGIS_OTEL_ENDPOINT=http://jaeger:4318
AEGIS_OTEL_SAMPLER_RATIO=1

# ---------- 日志 ----------
AEGIS_LOG__LEVEL=info
AEGIS_LOG__JSON=true